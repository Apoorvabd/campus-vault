# Google sign-in: the Web client ID from Google Cloud (a public identifier, not a secret)
GOOGLE_CLIENT_ID=

# DU Question Paper Bank (used only by scripts/scrape-pyq.ts, not the app itself)
DU_EMAIL=
DU_PASSWORD=
QB_BASE_URL=https://qb.exam.du.ac.in
QB_DELAY_MS=1500