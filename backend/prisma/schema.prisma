generator client {
  provider        = "prisma-client-js"
  // One SQL query with JOINs instead of one query per relation (fewer round trips)
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  FACULTY
  UNIVERSITY_ADMIN
  SUPER_ADMIN
}

enum SubjectType {
  DSC
  DSE
  SEC
  VAC
  AEC
  GE
}

enum ResourceType {
  PYQ
  NOTES
  SYLLABUS
  BOOK
  ASSIGNMENT
  LAB_MANUAL
  OTHER
}

enum ResourceStatus {
  PENDING
  APPROVED
  REJECTED
}

enum UploadType {
  IMAGE
  PDF
  VIDEO
  DOCUMENT
}

enum Visibility {
  PUBLIC
  PREMIUM
}

enum ResourceSourceType {
  HOSTED // File uploaded to Semester Forge (Cloudinary) — needs `upload`
  EXTERNAL_LINK // File lives elsewhere (Drive, another site) — needs `externalUrl`
  REFERENCE_ONLY // No file at all, only metadata (e.g. "I have this locally, ask me")
}

enum CollegeGender {
  BOYS
  WOMEN
  CO_ED
}

enum OtpPurpose {
  EMAIL_VERIFY // Signup: proves the email is real before the account exists
  PASSWORD_RESET // Forgot password: proves the user owns the account's email
}

model University {
  id String @id @default(cuid())

  name      String
  shortName String  @unique
  website   String?

  logoId String?
  logo   Upload? @relation("UniversityLogo", fields: [logoId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  colleges College[]
  courses  Course[]
  users    User[]

  @@index([shortName])
}

model College {
  id String @id @default(cuid())

  name      String
  shortName String?
  code      String?       @unique
  website   String?
  address   String?
  gender    CollegeGender @default(CO_ED)

  logoId String?
  logo   Upload? @relation("CollegeLogo", fields: [logoId], references: [id])

  universityId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  university University @relation(fields: [universityId], references: [id])

  users          User[]
  collegeCourses CollegeCourse[]

  @@unique([name, universityId])
  @@index([universityId])
}

model Course {
  id String @id @default(cuid())

  name      String
  shortName String?
  code      String? @unique

  durationYears  Int
  totalSemesters Int

  universityId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  university University @relation(fields: [universityId], references: [id])

  subjects       Subject[]
  users          User[]
  collegeCourses CollegeCourse[]

  @@unique([name, universityId])
  @@index([universityId])
}

model CollegeCourse {
  collegeId String
  courseId  String

  // Relations
  college College @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([collegeId, courseId])
  @@index([courseId])
}

model Subject {
  id String @id @default(cuid())

  name     String
  code     String
  semester Int?
  credits  Int

  type SubjectType

  description String?

  isActive Boolean @default(true)

  courseId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  course Course @relation(fields: [courseId], references: [id])

  resources Resource[]

  // User's private/local files linked to this subject
  userFiles UserFile[]

  @@unique([courseId, code])
  @@index([courseId])
  @@index([courseId, semester])
  @@index([type])
}

model User {
  id String @id @default(cuid())

  firstName String
  lastName  String?

  username String @unique

  email        String  @unique
  // null for accounts created with Google sign-in (they have no password)
  passwordHash String?

  // Google's stable account id (the `sub` claim). The email can change, this cannot.
  googleId String? @unique

  bio      String?
  headline String?

  avatarId String?
  avatar   Upload? @relation("UserAvatar", fields: [avatarId], references: [id])

  role UserRole @default(STUDENT)

  // Independent of `role` — grants permission to create Posts on the feed.
  // Admins grant/revoke this per user; role alone should not decide posting rights.
  canPost Boolean @default(false)

  universityId String
  collegeId    String
  courseId     String

  currentSemester Int

  // The user's own subject picks for `subjectsSemester`: DSC + GE + DSE + SEC + VAC + AEC.
  // Empty / unconfirmed = fall back to the course's DSC subjects for currentSemester.
  selectedSubjectIds  String[]  @default([])
  subjectsSemester    Int?
  subjectsConfirmedAt DateTime?

  isVerified Boolean @default(false)
  isActive   Boolean @default(true)

  // Bumped on logout. A refresh token carries the value it was issued with,
  // so every older refresh token stops working.
  tokenVersion Int @default(0)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  lastSeenAt DateTime?

  // Relations
  university University @relation(fields: [universityId], references: [id])
  college    College    @relation(fields: [collegeId], references: [id])
  course     Course     @relation(fields: [courseId], references: [id])

  uploads Upload[]

  uploadedResources Resource[] @relation("UploadedResources")
  approvedResources Resource[] @relation("ApprovedResources")

  // User's private/local files
  userFiles UserFile[]

  posts Post[]

  comments  Comment[]
  likes     Like[]
  bookmarks Bookmark[]

  @@index([universityId])
  @@index([collegeId])
  @@index([courseId])
}

model Upload {
  id String @id @default(cuid())

  originalName String
  fileName     String

  publicId String @unique

  url       String
  secureUrl String

  mimeType  String
  extension String

  size Int

  type UploadType

  uploadedById String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  uploadedBy User @relation(fields: [uploadedById], references: [id])

  avatarUsers User[] @relation("UserAvatar")

  universityLogos University[] @relation("UniversityLogo")
  collegeLogos    College[]    @relation("CollegeLogo")

  resource Resource?

  postCoverImages Post[]

  // Optional uploaded copy of a user's private file
  userFile UserFile?

  @@index([uploadedById])
  @@index([type])
}

model Resource {
  id          String  @id @default(cuid())
  title       String
  description String?

  resourceType ResourceType

  visibility Visibility @default(PUBLIC)

  status ResourceStatus @default(PENDING)

  rejectionReason String?

  downloadCount Int @default(0)

  // Where the actual file lives. HOSTED -> upload is required, externalUrl must be null.
  // EXTERNAL_LINK -> externalUrl is required, upload must be null.
  // REFERENCE_ONLY -> both are null (metadata-only entry, e.g. student's local copy).
  // This tri-state is enforced in the service layer (Prisma cannot express XOR constraints).
  sourceType ResourceSourceType @default(HOSTED)

  externalUrl String?

  // Where the link came from: du-qb, drive-seed, du-academicaffairs, ramanujan-library, dupyq, college:<Name>, college:<Name>-loose ...
  source String?

  subjectId String
  uploadId  String? @unique

  uploadedById String
  approvedById String?
  approvedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  subject Subject @relation(fields: [subjectId], references: [id])

  upload Upload? @relation(fields: [uploadId], references: [id])

  uploadedBy User @relation("UploadedResources", fields: [uploadedById], references: [id])

  approvedBy User? @relation("ApprovedResources", fields: [approvedById], references: [id])

  comments  Comment[]
  likes     Like[]
  bookmarks Bookmark[]

  @@unique([subjectId, externalUrl])
  @@index([subjectId])
  @@index([uploadedById])
  @@index([approvedById])
  @@index([status])
  @@index([resourceType])
  @@index([sourceType])
  @@index([source])
  @@index([subjectId, status])
}

model UserFile {
  id String @id @default(cuid())

  // Owner of the private file
  userId String

  // Subject to which the user linked this file

  subjectId String

  // File information
  name      String
  mimeType  String?
  extension String?
  size      Int?

  // Reference to the original file on the user's device.
  //
  // Example:
  // content://...
  //
  // This does NOT store the actual file.
  localUri String?

  // Optional uploaded copy.
  //
  // If the user uploads the file to Semester Forge,
  // this points to the Upload record which contains
  // the Cloudinary/CDN URL.

  uploadId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  upload Upload? @relation(fields: [uploadId], references: [id])

  @@index([userId])
  @@index([subjectId])
  @@index([userId, subjectId])
}

model Post {
  id String @id @default(cuid())

  title   String
  content String

  coverImageId String?

  authorId String

  isPublished Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  coverImage Upload? @relation(fields: [coverImageId], references: [id])

  author User @relation(fields: [authorId], references: [id])

  comments  Comment[]
  likes     Like[]
  bookmarks Bookmark[]

  @@index([authorId])
}

model Comment {
  id String @id @default(cuid())

  content String

  userId String

  postId     String?
  resourceId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  post Post? @relation(fields: [postId], references: [id], onDelete: Cascade)

  resource Resource? @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([postId])
  @@index([resourceId])
}

model Like {
  id String @id @default(cuid())

  userId String

  postId     String?
  resourceId String?

  createdAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  post Post? @relation(fields: [postId], references: [id], onDelete: Cascade)

  resource Resource? @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@unique([userId, resourceId])
  @@index([userId])
  @@index([postId])
  @@index([resourceId])
}

model Bookmark {
  id String @id @default(cuid())

  userId String

  postId     String?
  resourceId String?

  createdAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  post Post? @relation(fields: [postId], references: [id], onDelete: Cascade)

  resource Resource? @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@unique([userId, resourceId])
  @@index([userId])
  @@index([postId])
  @@index([resourceId])
}

// One-time code sent to an email address. Keyed by email, not by user, because
// signup verifies the email before the User row exists. One row per
// (email, purpose): sending a new code replaces the old one.
model EmailOtp {
  id String @id @default(cuid())

  // Always stored lowercase
  email   String
  purpose OtpPurpose

  // bcrypt hash of the 6-digit code
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  sentAt    DateTime

  // Set once the code is entered correctly. The app then holds the random
  // proof (only its sha256 is stored here) and sends it back with register.
  verifiedAt DateTime?
  proofHash  String?

  @@unique([email, purpose])
}

model AppUpdate {
  id                 String   @id @default(cuid())
  platform           String   @default("android")
  versionName        String   @map("version_name")
  versionCode        Int      @map("version_code")
  minimumVersionCode Int      @default(1) @map("minimum_version_code")
  downloadUrl        String   @map("download_url")
  releaseNotes       String?  @map("release_notes")
  forceUpdate        Boolean  @default(false) @map("force_update")
  isActive           Boolean  @default(true) @map("is_active")

  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@index([platform, isActive, versionCode(sort: Desc)])
  @@map("app_updates")
}

